# ---------- Stage 1: base image with all technical requirements ----------
FROM fedora:latest AS base
RUN dnf install -y httpd && dnf clean all
EXPOSE 80
ENTRYPOINT ["/usr/sbin/httpd"]
CMD ["-D", "FOREGROUND"]

# ---------- Stage 2: website 1 ----------
FROM base AS website1
COPY website1.html /var/www/html/
LABEL website=1

# ---------- Stage 3: website 2 ----------
FROM base AS website2
COPY website2.html /var/www/html/
LABEL website=2
